<?xml version="1.0" encoding="utf-8"?>
<!-- 「蓋章」按鈕的底：與琺瑯站牌的色帶同一個藍（wg_plate_band_1，淺深色模式都是 #2C4F86），字用 wg_plate_band_ink（暖白），
     兩種模式對比都超過 8:1。深色卡片（#101C2E）上這個藍比卡面亮，仍看得出是可按的鈕。
     整條按鈕高 28dp（小卡、中卡都是），圓角 14dp＝半高，維持原本的膠囊形；顏色沿用舊的實心膠囊，沒有描邊。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="@color/wg_plate_band_1" />
</shape>
