<?xml version="1.0" encoding="utf-8"?>
<!-- 「沒有 collection.json」（App 還沒開過、版本不認得）：標題一行小字＋一段邀請文案，沒有地圖。
     不畫一張長得像有資料、其實是空的卡。小／中共用，字級由 CollectionWidgetRender 依尺寸設。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_card"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="15dp">

    <TextView
        android:id="@+id/wc_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/wg_ink_soft"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/wc_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="5"
        android:textColor="@color/wg_ink"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
