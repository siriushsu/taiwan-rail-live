<?xml version="1.0" encoding="utf-8"?>
<!-- 車站收集・小（2×2）。與 iOS SmallCollectionView 同一個資訊層級：
     標題列（範圍名＋「車站收集」）→ 左下文字欄（百分比大字、已收集、還有）＋右下點陣地圖。
     文字欄佔 58%、地圖欄佔 42%（權重）；地圖 ImageView 用 fitEnd 貼欄位右下，高度／寬度誰先到頂就以誰為準，
     所以文字與地圖在任何格子形狀下都不會疊（Pixel 2×2 是 140×222dp 直長條，Samsung 是 150×207dp）。
     地圖有淺／深兩張 Bitmap 疊在同一格，資源限定的 alpha 決定露出哪一張（見 dimens_collect.xml）。
     🔴 只准用 RemoteViews 白名單裡的類別（verify_widget_layouts.mjs 會擋）；ProgressBar／View 之類見那支的註解。
     標題列右端是「蓋章」按鈕（wc_stamp）：自己綁一個 PendingIntent 開 railisland://checkin，按鈕以外的地方仍是開旅程護照。
        按鈕固定 18dp 高（比標題矮），所以不會把標題列撐高、也不會壓到下面的數字；寬度不夠時由 CollectionWidgetRender 依序收副標、縮字級。
     🔴 空狀態（一站都還沒收集）與正常狀態共用這一張，由 CollectionWidgetRender 決定露出哪幾個 TextView；
        兩者【id 完全相同】，binder 只有一份。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_card"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wc_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/wg_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wc_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/wg_ink_soft"
            android:textSize="11sp" />

        <Button
            android:id="@+id/wc_stamp"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/wc_stamp_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingTop="0dp"
            android:paddingEnd="8dp"
            android:paddingBottom="0dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/wg_plate_band_ink"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="58"
            android:gravity="bottom"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wc_pct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/wg_ink"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wc_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/wg_ink"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wc_remain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/wg_ink_soft"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/wc_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:textColor="@color/wg_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wc_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="4"
                android:textColor="@color/wg_ink_soft"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/wc_map_slot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="42"
            android:paddingTop="4dp">

            <ImageView
                android:id="@+id/wc_map_light"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="@dimen/wc_alpha_light"
                android:contentDescription="@null"
                android:scaleType="fitEnd" />

            <ImageView
                android:id="@+id/wc_map_dark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="@dimen/wc_alpha_dark"
                android:contentDescription="@null"
                android:scaleType="fitEnd" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
