<?xml version="1.0" encoding="utf-8"?>
<!-- 小工具挑選器／釘選框的預覽（靜態 XML，執行期不跑 binder）。
     🔴 這是【示意資料】（201／538，37%，全台），不是使用者的資料——與 iOS 圖庫預覽 CollectionWidgetPreview.json 同一組數字；
        地圖是用同一支 CollectionMapRender 對示意 payload 畫出來的圖（wg_collect_preview_map，淺／深各一張）。
     版面照 widget_collect_small.xml（58／42 權重欄、fitEnd 貼右下），不綁任何 id。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_card"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="全台"
            android:textColor="@color/wg_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="車站收集"
            android:textColor="@color/wg_ink_soft"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="58"
            android:gravity="bottom"
            android:orientation="vertical">

            <!-- 實際卡片是同一個 TextView 裡「37」大、「%」用 RelativeSizeSpan 縮成 0.44 倍；靜態 XML 沒有 span，
                 拆成兩個 TextView 靠基線對齊，寬度才跟實際一致（整串 34sp 會多出一截、把「%」擠掉）。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="37"
                    android:textColor="@color/wg_ink"
                    android:textSize="34sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="%"
                    android:textColor="@color/wg_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="已收集 201 座"
                android:textColor="@color/wg_ink"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="還有 337 座"
                android:textColor="@color/wg_ink_soft"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="42"
            android:paddingTop="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitEnd"
                android:src="@drawable/wg_collect_preview_map" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
