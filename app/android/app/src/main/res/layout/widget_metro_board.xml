<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="118dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_metro_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_accent"
            android:layout_width="5dp"
            android:layout_height="38dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_station"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="台北車站"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="臺北捷運"
                android:textColor="#BFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="12:34 更新"
            android:textColor="#A8FFFFFF"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:contentDescription="重新整理"
            android:padding="7dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_last_train"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:text="末班 往淡水 23:58"
        android:textColor="#FFFFB86B"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:text="正在讀取官方班次…"
        android:textColor="#D9FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/widget_row1_dot" android:layout_width="7dp" android:layout_height="7dp" android:contentDescription="@null" android:src="@drawable/widget_dot" />
            <TextView android:id="@+id/widget_row1_dest" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="往 南港展覽館" android:textColor="#FFFFFFFF" android:textSize="14sp" />
            <Chronometer android:id="@+id/widget_row1_chrono" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/widget_row1_time" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="end" android:text="2:30" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_row1_crowd" android:layout_width="76dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:gravity="end" android:maxLines="1" android:text="▰ ▰ ▰ ▰ ▰ ▰" android:textColor="#FF72D99B" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/widget_row2_dot" android:layout_width="7dp" android:layout_height="7dp" android:contentDescription="@null" android:src="@drawable/widget_dot" />
            <TextView android:id="@+id/widget_row2_dest" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="往 頂埔" android:textColor="#FFFFFFFF" android:textSize="14sp" />
            <Chronometer android:id="@+id/widget_row2_chrono" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/widget_row2_time" android:layout_width="64dp" android:layout_height="wrap_content" android:gravity="end" android:text="5:40" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_row2_crowd" android:layout_width="76dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:gravity="end" android:maxLines="1" android:text="▰ ▰ ▰ ▰ ▰ ▰" android:textColor="#FFFFC95A" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
