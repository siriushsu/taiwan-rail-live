<?xml version="1.0" encoding="utf-8"?>
<!-- 雙看板鐵路段的次列（第二班起）。id 與主角列 widget_mixed_rail_hero.xml、發車看板 widget_rail_row.xml 相同。
     最小列高取 @dimen（MixedWidgetRender 用同一個值算列數，見 dimens_widget_mixed.xml）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wmx_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/wmx_follow_h"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/wrr_mark"
        android:layout_width="3dp"
        android:layout_height="26sp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/wg_meter_block" />

    <!-- 方向三角：北上尖端朝上、南下朝下（底:高＝9:7，同 widget_rail_row）。沒有方向時 binder 設成 GONE。 -->
    <ImageView
        android:id="@+id/wrr_heading"
        android:layout_width="10dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/wg_heading_north" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wrr_train"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="自強 123"
            android:textColor="@color/wg_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wrr_dest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="往 花蓮"
            android:textColor="@color/wg_ink_faint"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wrr_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:text="準點"
        android:textColor="@color/wg_ok"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">
        <TextView
            android:id="@+id/wrr_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="09:41"
            android:textColor="@color/wg_ink"
            android:textSize="19sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wrr_platform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/wg_ink_faint"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
