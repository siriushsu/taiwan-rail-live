<?xml version="1.0" encoding="utf-8"?>
<!-- 狀態 6「未設定車站」與載入／失敗訊息。設計稿把這一張畫成另一種骨架（沒有站號、沒有方向、
     多一顆按鈕），所以【不】硬套站牌版面——套進去就會出現一個空的站號徽章與一條空的方向列。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingEnd="15dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/wm_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="軌島 · 捷運看板"
        android:textColor="@color/wg_ink_faint"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/wm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="還沒選車站"
        android:textColor="@color/wg_ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="選一個常用車站與方向，這塊小工具就會一直顯示下一班。"
        android:textColor="@color/wg_ink_soft"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/wm_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/wg_button"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="選擇車站"
        android:textColor="@color/wg_on_accent"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
