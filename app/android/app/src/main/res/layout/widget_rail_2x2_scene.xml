<?xml version="1.0" encoding="utf-8"?>
<!-- 發車看板・小・背景「場景」（mockup 小卡 C）：街角平交道（wg_scene_small）＋小站名牌，下面一班車，
     最底一行只放更新時間（160dp 寬放不下來源註腳，wr_note 收掉）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_card">

    <ImageView
        android:id="@+id/wr_scene"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginStart="@dimen/wg_scene_inset"
        android:layout_marginTop="@dimen/wg_scene_inset"
        android:layout_marginEnd="@dimen/wg_scene_inset_end"
        android:background="@drawable/wg_scene_clip"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/wg_scene_small" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginStart="@dimen/wg_scene_inset"
        android:layout_marginTop="@dimen/wg_scene_inset"
        android:layout_marginEnd="@dimen/wg_scene_inset_end"
        android:background="@drawable/wg_scene_fade"
        android:contentDescription="@null" />

    <!-- 09-23 使用者：「C款的背景 我希望在使用的畫面能看到列車，要剛好放在右上角那邊能看到的地方」（選「疊下一班車模」）。
         下一班車種的代表車，與 A 同一套車圖、同一個 bindCar；排在淡出層之後，車身不被淡掉。小卡站名牌約佔左邊 95dp，車縮成 48dp 貼右上；站名長到蓋過來時站牌在上層。 -->
    <ImageView
        android:id="@+id/wr_car"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/wg_car_emu3000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <include layout="@layout/widget_eplate_small" />
        </FrameLayout>

        <TextView android:id="@+id/wr_route" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:text="全部列車" android:textColor="@color/wg_ink_soft"
            android:textSize="9sp" />
        <LinearLayout android:id="@+id/wr_rows" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_marginTop="2dp" android:layout_weight="1" android:orientation="vertical">
            <include layout="@layout/widget_rail_row_demo_compact1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/wr_note" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="台鐵・高鐵發車看板"
                android:textColor="@color/wg_ink_faint" android:textSize="8sp" android:visibility="invisible" />
            <TextView android:id="@+id/wr_stamp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:text="09:41" android:textColor="@color/wg_ink_faint" android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
