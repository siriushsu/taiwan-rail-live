<?xml version="1.0" encoding="utf-8"?>
<!-- 發車看板・中・背景「場景」高卡版：與 widget_rail_4x2_scene.xml 逐行相同，只差示範列 2→3。
     卡片回報高度 ≥202dp（Samsung One UI 5×2 回報 406×207dp）時用這張放三班（與 iOS 中卡場景版同為三班）；
     Pixel 5×2 只有 180dp，第三班會被切 ⇒ 仍用兩班那張。🔴 改其中一張要同步另一張。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_card">

    <ImageView
        android:id="@+id/wr_scene"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginStart="@dimen/wg_scene_inset"
        android:layout_marginTop="@dimen/wg_scene_inset"
        android:layout_marginEnd="@dimen/wg_scene_inset_end"
        android:background="@drawable/wg_scene_clip"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/wg_scene_medium" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginStart="@dimen/wg_scene_inset"
        android:layout_marginTop="@dimen/wg_scene_inset"
        android:layout_marginEnd="@dimen/wg_scene_inset_end"
        android:background="@drawable/wg_scene_fade"
        android:contentDescription="@null" />

    <!-- 09-23 使用者：「C款的背景 我希望在使用的畫面能看到列車，要剛好放在右上角那邊能看到的地方」（選「疊下一班車模」）。
         下一班車種的代表車，與 A 同一套車圖、同一個 bindCar；排在淡出層之後，車身不被淡掉。與 A 中卡頭帶的車同尺寸。 -->
    <ImageView
        android:id="@+id/wr_car"
        android:layout_width="88dp"
        android:layout_height="57dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/wg_car_emu3000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="62dp">
            <include layout="@layout/widget_eplate_small" />
        </FrameLayout>

        <TextView android:id="@+id/wr_route" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:text="全部目的地 · 直達／停靠／終到／通過"
            android:textColor="@color/wg_ink_soft" android:textSize="9sp" />
        <LinearLayout android:id="@+id/wr_rows" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_marginTop="2dp" android:layout_weight="1" android:orientation="vertical">
            <include layout="@layout/widget_rail_rows_demo" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/wr_note" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="台鐵即時誤點 · 高鐵表定時刻"
                android:textColor="@color/wg_ink_faint" android:textSize="8sp" />
            <TextView android:id="@+id/wr_stamp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:maxLines="1" android:text="09:41 更新"
                android:textColor="@color/wg_ink_faint" android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
