<?xml version="1.0" encoding="utf-8"?>
<!-- 大字好讀版：和標準列共用相同 id，但列高、班次、狀態與時刻都實際放大。
     目的地副標由 binder 隱藏，遵守「少放欄位，不把主要文字縮回去」。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/wrr_mark"
        android:layout_width="4dp"
        android:layout_height="30dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/wg_meter_block" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wrr_train"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="自強 123"
            android:textColor="@color/wg_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wrr_dest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="往 花蓮"
            android:textColor="@color/wg_ink_faint"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/wrr_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:maxLines="1"
        android:text="準點"
        android:textColor="@color/wg_ok"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wrr_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="09:41"
        android:textColor="@color/wg_ink"
        android:textSize="23sp"
        android:textStyle="bold" />
</LinearLayout>
