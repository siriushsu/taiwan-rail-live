<?xml version="1.0" encoding="utf-8"?>
<!-- 小工具的琺瑯色票。hex 全部照抄設計稿的 chip 值（TOKENS.md），不目視取色。
     🔴 深色版在 values-night/：RemoteViews 的資源是由【桌面 launcher 的 configuration】解析的，
        所以只要放 -night 就會跟著系統深淺模式走——設計稿的「琺瑯（亮）」與「夜行（暗）」是
        同一個版型的兩種模式，不是兩個版型（兩個版型是 1a 站牌與 1b 看板）。 -->
<resources>
    <color name="wg_paper">#FDFBF4</color>
    <color name="wg_paper_edge">#E4DAC0</color>
    <color name="wg_shadow">#1F1A0F14</color>
    <color name="wg_ink">#26497E</color>
    <color name="wg_ink_soft">#5C6B7F</color>
    <color name="wg_ink_faint">#8A8471</color>
    <color name="wg_navy">#2A4A73</color>
    <color name="wg_rule">#E0D7BE</color>
    <color name="wg_ok">#1B8F4D</color>
    <color name="wg_warn">#D2A12A</color>
    <color name="wg_bad">#D23C2A</color>
    <color name="wg_bad_wash">#FBEAE6</color>
    <color name="wg_warn_wash">#FAF1DA</color>
    <color name="wg_chip_wash">#EFE7CF</color>
    <color name="wg_badge_ink">#3A3226</color>
    <color name="wg_on_accent">#FFFFFF</color>
    <color name="wg_meter_low">#1B8F4D</color>
    <color name="wg_meter_mid">#D2A12A</color>
    <color name="wg_meter_high">#D23C2A</color>
    <color name="wg_meter_empty">#D8CFB6</color>
    <!-- 小工具背景 A／C（2026-09-23）。頭帶照 mockup 的淺色漸層；深色改成本卡片夜行紙色系的藍，
         不用 mockup 的中性灰（Android 卡片的夜色是 #101C2E，灰頭帶會像貼上去的另一張紙）。 -->
    <color name="wg_band_start">#EEF3FB</color>
    <color name="wg_band_end">#F6F1E7</color>
    <!-- 場景淡入卡片紙色：同一個紙色、透明度 0（漸層從透明走到不透明，中間不會混進黑色）。 -->
    <color name="wg_paper_clear">#00FDFBF4</color>
    <!-- C 的琺瑯站名牌：網站 .plate 同一組色票（mockup .eplate），鄰站帶兩種模式同色。 -->
    <color name="wg_plate_g1">#FFFFFF</color>
    <color name="wg_plate_g2">#F7F5EE</color>
    <color name="wg_plate_g3">#EDEBE0</color>
    <color name="wg_plate_frame">#767061</color>
    <color name="wg_plate_ink">#26497E</color>
    <color name="wg_plate_band_1">#2C4F86</color>
    <color name="wg_plate_band_2">#26497E</color>
    <color name="wg_plate_band_3">#1F3D6B</color>
    <color name="wg_plate_band_ink">#FFF8EC</color>
    <color name="wg_plate_shadow">#47281E10</color>
</resources>
