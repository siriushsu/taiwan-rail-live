<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hant</string>
	<key>CFBundleDisplayName</key>
        <string>軌島</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- 軌島只用 HTTPS 標準加密（屬出口管制豁免）；宣告 false 讓送審不再詢問加密合規，也不需上傳加密文件 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Google 登入 redirect 回 App 用的 URL scheme，值 = GoogleService-Info.plist 的 REVERSED_CLIENT_ID -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>google-signin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.415549765868-gscdv9songgu0aa4p1sqanllqb6s4dbe</string>
			</array>
		</dict>
	</array>
	<!-- 2026-07-29 改寫:舊字串寫「位置只在裝置上使用,不會上傳」,在「校正旅程」上線後
	     變成不實陳述——座標本身確實不離開手機(伺服器端 hasGeoKeys 收到含座標的 payload 直接 400),
	     但由座標換算出的沿線里程/時間/速度/精度會連同裝置識別碼上傳。purpose string 烤在 binary 裡,
	     事後才發現要重出一顆 build,所以這裡把三種用途與「上傳什麼」一次寫清楚。
	     與 privacy.html 第 3 節、app/APP_REVIEW_NOTES_v1_FREE.md 必須三份一致,改一份就要三份同輪改。 -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>軌島用你的位置做三件事：開啟時把地圖停在你所在的地方、列出附近的車站與行駛中的列車，以及在你主動接下「校正旅程」後，於乘車途中記錄位置來校正列車位置推估。座標不會離開這支手機——校正旅程只上傳換算後的沿線里程、時間、速度與定位精度。</string>
	<!-- @capacitor/geolocation 8.2.0 依賴的 iOS library 要求此 key;軌島不請求 Always 權限、不開背景定位 capability -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>軌島用你的位置做三件事：開啟時把地圖停在你所在的地方、列出附近的車站與行駛中的列車，以及在你主動接下「校正旅程」後，於乘車途中記錄位置來校正列車位置推估。座標不會離開這支手機——校正旅程只上傳換算後的沿線里程、時間、速度與定位精度。</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
