{
  "sourceLanguage": "zh-Hant",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rail Island"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌島"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rail Island uses location while the app is open for the blue dot, location camera and nearby stations. Your latest position is sent to people with your short-lived journey link only when you separately enable live location sharing. Location stops in the background or on the Lock Screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌島はAppの使用中、青い点、現在地カメラ、近くの駅のために位置情報を使います。旅程の現在地共有を別途オンにした場合だけ、短時間リンクを持つ人へ最新位置を送信します。バックグラウンドまたはロック画面では停止します。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rail Island does not request Always access or continue location in the background. The regular blue dot stays on-device; only separately enabled live journey sharing sends the latest position while the app is in the foreground."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌島は「常に許可」を求めず、バックグラウンドで位置取得を続けません。通常の青い点は端末内だけで使用し、旅程の現在地共有を別途オンにした場合だけ、Appが前面にある間に最新位置を送信します。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
