            "state": "translated",
            "value": "アドレスバー横のアイコン→サイト設定→位置情報を許可してください"
          }
        }
      }
    },
    "可在網址列鎖頭圖示→位置 允許": {
      "extractionState": "manual",
      "localizations": {
