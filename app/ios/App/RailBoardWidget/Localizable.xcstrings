        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台湾鉄路の遅延情報は非リアルタイムです：{time}時点のデータから推定・{n}本が遅延中"
          }
        }
      }
    },
    "台鐵誤點推估（依 {time} 即時資料投射）· {n} 班誤點中": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
