        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードは次の列車へ自動更新されません。続きは軌島で開き直してください。"
          }
        }
      }
    },
    "去過的車站會變成一枚章，收在護照裡；同一座站去越多次，章上的數字越大。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visited stations become Passport stamps; repeat visits increase the number on each stamp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪れた駅をパスポートに収集し、訪問回数をスタンプに表示します。"
          }
        }
      }
    },
    "古亭": {
      "extractionState": "manual",
