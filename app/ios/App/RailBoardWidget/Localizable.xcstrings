    "左右拖曳調整時刻（1 像素＝1 分鐘），方向鍵每次 1 分鐘；點時間數字可直接指定時刻": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to adjust time (1 px = 1 min); arrow keys adjust by one minute. Tap the time to enter it directly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右にドラッグして時刻を調整（1px＝1分）。矢印キーは1分刻み。時刻をタップすると直接入力できます。"
          }
        }
      }
    },
    "左營": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuoying"
          }
