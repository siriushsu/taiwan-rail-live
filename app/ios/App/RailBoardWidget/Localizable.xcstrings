    "按「分享」": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Share"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「共有」を押す"
          }
        }
      }
    },
    "按「放空模式」": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Ambient mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「鑑賞モード」を押す"
          }
        }
      }
    },
    "按「附近車站」回到目前位置，點清單裡的站直接開看板": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Nearby stations to return to your current position, then tap a station to open its board"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「近くの駅」で現在地に戻り、一覧の駅を押すと案内を開けます"
          }
        }
      }
    },
    "按「前往 GitHub 開 issue」，內容會幫你填好": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Continue to GitHub issue; the report will be filled in for you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「GitHub issueを作成」を押すと内容が自動入力されます"
          }
        }
      }
    },
    "按「給軌島評分」會前往 iPhone 的 App Store 或 Android 的 Google Play": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate Rail Island opens the iPhone App Store or Android Google Play."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「軌島を評価」を押すと、iPhoneはApp Store、AndroidはGoogle Playを開きます。"
          }
        }
      }
    },
    "按上方的「離開」回到即時地圖": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Leave at the top to return to the live map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部の「終了」でリアルタイム地図へ戻る"
          }
        }
      }
    },
    "按下「我上車了」之後，再去點一班還沒發車的車，時鐘不會再被撥走（謝謝網友回報）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you tap I am on board, tapping a train that has not departed yet no longer winds the clock away from now. Thanks to the rider who reported it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「乗車しました」を押した後に、まだ発車していない列車をタップしても時計が現在からずれなくなりました。ご報告ありがとうございます。"
          }
        }
      }
    },
    "按小卡上的「結束」停止跟車(× 只是把卡收起來,車還在跟)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use End on the card to stop following. × only hides the card; following continues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードの「終了」で列車追跡を止めます。×はカードを隠すだけで追跡は続きます。"
          }
        }
      }
    },
    "按卡片上的「我上車了」，並選好在哪一站下車": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “I’m on board” on the card and choose where you will get off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードの「乗車する」を押して下車駅を選択"
          }
        }
      }
    },
    "按地圖上的「附近車站」": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Nearby stations on the map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図の「近くの駅」を押す"
          }
        }
      }
    },
    "按地圖上的「隨機跟隨」": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Follow random train on the map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図の「ランダム追跡」を押す"
          }
        }
      }
    },
    "按地圖右上的四角鈕": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the four-corner button at top right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図右上の四隅ボタンを押す"
          }
        }
      }
    },
    "按頁尾（手機在「更多」的關於段）的「回報問題或建議」": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select Report a problem or suggestion in the footer; on phones it is under About in More"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フッターの「問題・提案を報告」を押す（スマートフォンでは「その他」の概要欄）"
          }
        }
      }
    },
    "按站名下方的「追蹤這站」，選方向與要追蹤多久（30／60／90 分鐘）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Follow this station below the station name, then choose a direction and 30, 60 or 90 minutes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅名の下にある「この駅を追跡」を押し、方向と30／60／90分を選ぶ"
          }
        }
      }
    },
    "按站名旁的「追蹤一班車」": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Follow a train beside the station name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅名の横にある「列車を追跡」を押す"
          }
        }
      }
    },
    "查看": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示"
          }
        }
      }
    },
    "查看 {train} 次誤點履歷・近 30 天最糟單日全程誤點 {worst} 分、平均 {average} 分、{days} 天有紀錄": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View train {train} delay history · past 30 days: worst full-route delay {worst} min, average {average} min, {days} days recorded"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{train}列車の遅延履歴を見る・過去30日の最大全区間遅延{worst}分、平均{average}分、記録{days}日"
          }
        }
      }
    },
    "查看台鐵或高鐵接下來的直達、停靠與終到列車；想看通過本站不停靠的車，在「只看這些」打開「含通過列車」。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See upcoming direct, stopping and terminating TRA or HSR trains. To also show trains that pass without stopping, turn on \"Include passing trains\" under Filters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台湾鉄路・高鉄の直通・停車・終着列車を表示します。通過（停車しない）列車も表示するには「表示条件」で「通過列車も表示」をオンにしてください。"
          }
        }
      }
    },
    "查看通行證": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View Pass"
