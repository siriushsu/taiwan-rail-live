    "找不到這個車站，請重新設定": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Station not found; please configure it again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅が見つかりません。再設定してください"
          }
        }
      }
    },
    "找不到就檢查一下車次是不是今天的班次——停駛或加班車不一定在時刻表裡。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you cannot find it, check that the train runs today. Cancelled or extra services may not appear in the timetable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つからない場合は、本日の列車か確認してください。運休や臨時列車は時刻表にない場合があります。"
          }
        }
      }
    },
    "找不到路網資料（data/*.json 還在準備）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rail network data is unavailable (data files are still being prepared)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鉄道ネットワークデータを読み込めません（データを準備中です）。"
          }
        }
      }
    },
    "把介面收掉，只留地圖。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the interface and leave only the map."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UIを隠して地図だけを表示します。"
          }
        }
      }
    },
    "把地圖拉近就看得到記號": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom in to see the markers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図を拡大してマーカーを表示"
          }
        }
      }
    },
    "把底圖換成衛星照片，看得到實際的軌道與站場。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to satellite imagery to see the real tracks and station grounds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景を衛星画像に切り替え、実際の線路と駅構内を確認できます。"
          }
        }
      }
    },
    "把家、公司、拍車點存下來，看有哪些火車會經過那裡。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save home, work or a photography spot and see which trains pass nearby."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅・職場・撮影地点を保存し、近くを通る列車を確認します。"
          }
        }
      }
    },
    "把捷運站放上主畫面或鎖定畫面，不開 App 就看得到下一班往哪裡、還有幾分鐘。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a metro station on your Home or Lock Screen to see the next direction and countdown without opening the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メトロ駅をホーム画面やロック画面に置き、アプリを開かずに次の列車の方向と残り時間を確認できます。"
          }
        }
      }
    },
    "把現在的畫面（地點＋時間）或正在跟的車分享給別人，對方打開就是同一個畫面。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the current place and time or the train you are following so someone else opens the same view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の場所と時刻、または追跡中の列車を共有し、同じ画面を開けます。"
          }
        }
      }
    },
    "改用另一種方式登入": {
      "extractionState": "manual",
      "localizations": {
