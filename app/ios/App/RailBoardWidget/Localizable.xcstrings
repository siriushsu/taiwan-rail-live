    "跟台鐵車時，卡片上的「誤點履歷 ›」可看這班車近 30 天的準點統計；回溯 90 天的逐日紀錄與週幾圖需要軌島通行證": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While following a TRA train, Delay history shows its free 30-day summary. Daily records and weekday charts covering 90 days require a Rail Island Pass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台湾鉄路を追跡中、カードの「遅延履歴」で無料の30日集計を確認できます。90日の日別記録と曜日グラフには軌島パスが必要です。"
          }
        }
      }
    },
    "跟完": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Followed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡完了"
          }
        }
      }
    },
    "跟完一趟車，起訖站自動成章": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completing a journey stamps its origin and destination"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完乗すると始発駅と終着駅を自動収集"
          }
        }
      }
    },
    "跟完一整趟就蓋一枚章，收集起來變成你的旅程紀錄。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow an entire journey to earn a stamp and build your travel record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全区間を追跡してスタンプを集め、自分の旅程記録を作ります。"
          }
        }
      }
    },
    "跟車卡或看板標題的收藏鈕點一下收藏": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the star on a follow card or station board"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡カードまたは駅案内の星をタップ"
          }
        }
      }
    },
    "跟車時在鎖定畫面與動態島顯示即時動態（iOS 17.6 以上）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live train status on the Lock Screen and Dynamic Island while following (iOS 17.6+)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列車追跡中にロック画面とDynamic Islandへライブ表示（iOS 17.6以降）"
          }
        }
      }
    },
    "跟到終點會蓋一枚完乘章（收在「護照」）。加速播放沒問題，但中途跳時間就不算。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following from origin to terminus earns a Journey Passport stamp. Speed-up is allowed; jumping through time is not."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始発から終点まで追跡すると旅程パスポートに完乗スタンプが入ります。早送りは可能ですが、時間を飛ばすと対象外です。"
          }
        }
      }
    },
    "跟到終點會蓋一枚完乘章（收在「護照」）。加速播放沒問題，但中途跳時間就不算。手機在跟車途中點車站，看板會和跟車小卡併成同一張卡的兩個分頁，不會互相蓋掉。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow to the terminus to earn a completion stamp in Passport. Faster playback still counts, but jumping through time does not. On phones, a station board opens as a second tab in the follow card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終点まで追跡すると「パスポート」に完乗スタンプが付きます。早送りは対象ですが、途中で時刻を飛ばすと対象外です。スマートフォンで駅を押すと、追跡カード内の別タブとして案内が開きます。"
          }
        }
      }
    },
    "跟這班車 →": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow this train →"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この列車を追跡 →"
          }
        }
      }
    },
    "跟著山海號或平原號連續跟滿半圈（臺北→折返點枋寮）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Shanhai or Pingyuan continuously for half a circuit, from Taipei to Fangliao"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "山海号または平原号を台北から折返しの枋寮まで連続追跡"
          }
        }
      }
    },
    "跟著車的時候可以排提醒，快到站前手機會響。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
