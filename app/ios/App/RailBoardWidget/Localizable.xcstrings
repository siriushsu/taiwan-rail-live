      }
    },
    "手動拖圖會解除所在地鏡頭，定位藍點仍持續更新": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragging the map releases the location camera, while the blue dot continues updating"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図を手で動かすと現在地カメラは解除されますが、青い点は更新を続けます"
          }
        }
      }
    },
    "手機：點頂端右邊那顆圓鈕（上面寫著目前在哪一群）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone: tap the round button at the top right, labelled with the current group"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォン：現在のグループ名がある右上の丸いボタンを押す"
          }
        }
      }
    },
    "手機地圖右下角的版權資訊不會再折成一大塊蓋住速度調整鈕：改成貼著底緣一整條、放不下的部分橫向可捲，授權連結一個都沒少，仍然看得到也點得到。切到衛星影像時字串較長，原本折成四行最嚴重，現在一樣是一條（謝謝網友回報）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map attribution at the bottom right of the phone map sits on a single line along the bottom edge, scrolling sideways when it does not fit, instead of wrapping into a block over the speed control. Every licence link is still there and still tappable. In satellite mode the text is longer, and it stays on one line there too. (Thanks to the reader who reported this.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンの地図右下の著作権表示を、下端に沿った一行にしました。収まらない部分は横にスクロールし、速度調整ボタンを覆うブロックにはなりません。ライセンスのリンクは一つも欠けておらず、表示もタップもできます。衛星画像モードでは文字列が長くなりますが、そこでも一行のままです。（ご報告いただいた方に感謝します。）"
          }
        }
      }
    },
    "手機拖時刻尺、桌面按 ← → 各移動 10 分鐘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the time ruler on phone or use ← → on desktop to move 10 minutes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンは時刻目盛をドラッグ、デスクトップは← →で10分移動"
          }
        }
      }
    },
    "手機長時間掛著看，建議打開省電模式。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable power saving when leaving the map open on a phone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンで長時間表示する場合は省電力モードをおすすめします。"
          }
        }
      }
    },
    "手機按底部「搜尋」、桌面點右上的搜尋框": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
