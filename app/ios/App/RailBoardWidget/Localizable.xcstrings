    "輸入「台北」找車站、輸入「431」找那班車、輸入「鳴日」找列車介紹": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter “Taipei” for a station, “431” for a train, or “Future” for a tourist-train story."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「台北」で駅、「431」で列車、「鳴日」で観光列車の紹介を検索できます。"
          }
        }
      }
    },
    "選一個車站，桌面就會顯示官方的下一班還有幾分鐘。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a station to show the official next-arrival time on your Home screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駅を選ぶと、公式の次列車到着時分をホーム画面に表示します。"
          }
        }
      }
    },
    "選一個捷運站": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a metro station"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メトロ駅を選択"
          }
        }
      }
    },
    "選一個捷運站，看下一班還有多久。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a metro station and see when the next train arrives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メトロ駅を選んで次の列車までの時間を確認します。"
          }
        }
      }
    },
    "選一個類型、寫一句說明": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a category and add a short description"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種類を選び、短い説明を書く"
          }
        }
      }
    },
    "選一班車，鎖定畫面會顯示它的表定時刻與官方誤點分鐘（實際約幾點到）。卡片上隨時可按「結束」收起。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a train to show its scheduled time and official delay minutes (estimated actual arrival) on the lock screen. Tap End on the card at any time to dismiss it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列車を選ぶと、予定時刻と公式遅延分（実際の到着見込み）をロック画面に表示します。カードの「終了」でいつでも閉じられます。"
          }
        }
      }
    },
    "選一張適合你的票，開啟進階功能，也支持軌島繼續運轉。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the pass that suits you to unlock advanced features and support Rail Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分に合うパスを選び、高度な機能を利用しながら軌島の運営を応援できます。"
          }
        }
      }
    },
    "選分享畫面或分享正在跟的車": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the current view or followed train"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の画面または追跡列車を選択"
          }
        }
      }
    },
    "選台鐵、高鐵或共站，查看接下來的停靠、終到與通過列車。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose TRA, HSR or a shared station to see upcoming stopping, terminating and passing trains."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台湾鉄路、高鉄、共用駅を選び、次の停車・終着・通過列車を確認します。"
          }
        }
      }
    },
    "選台鐵、高鐵或共站，查看接下來的停靠與終到列車；想看通過本站的車，在「只看這些」裡打開。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose TRA, HSR or a shared station to see upcoming stopping and terminating trains. Turn on passing trains under Filters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台湾鉄路、高鉄、共用駅を選び、次の停車・終着列車を確認します。通過列車は「表示条件」で表示できます。"
          }
        }
      }
    },
    "選你的目的站，產生一個「活的」行程連結——對方看得到列車位置與到站時刻，你不用一直回傳定位。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your destination to create a live journey link. The recipient can see the train and arrival time without continuous location sharing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的駅を選ぶと、列車位置と到着時刻が見えるライブ旅程リンクを作成します。位置情報を送り続ける必要はありません。"
          }
        }
      }
    },
    "選要看哪個系統": {
      "extractionState": "manual",
