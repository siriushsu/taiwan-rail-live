    "南迴與台東線交會的東南門戶": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Southeastern gateway where the South Link and Taitung lines meet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "南廻線と台東線が交わる南東部の玄関駅です。"
          }
        }
      }
    },
    "南迴線": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "South Link Line"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "南廻線"
          }
        }
      }
    },
    "南迴線枋寮—臺東的觀光列車：柴電機車牽引的復古藍皮客車，全台最後可開窗、無空調的普快車廂。沿途貼著太平洋與中央山脈尾稜跑，2021 年整修後以觀光列車之姿復駛。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A South Link tourist train from Fangliao to Taitung, formed of heritage blue coaches with opening windows and no air conditioning. It returned in 2021 after restoration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "枋寮から台東へ南廻線を走る観光列車です。窓を開けられる非冷房のレトロな藍皮客車をディーゼル機関車が牽引し、2021年に復活しました。"
          }
        }
      }
    },
    "南迴線臺東—枋寮的觀光列車：柴電機車牽引的復古藍皮客車，全台最後可開窗、無空調的普快車廂。沿途貼著太平洋與中央山脈尾稜跑，2021 年整修後以觀光列車之姿復駛。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A South Link tourist train from Taitung to Fangliao, formed of heritage blue coaches with opening windows and no air conditioning. It returned in 2021 after restoration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "台東から枋寮へ南廻線を走る観光列車です。窓を開けられる非冷房のレトロな藍皮客車をディーゼル機関車が牽引し、2021年に復活しました。"
          }
        }
      }
    },
