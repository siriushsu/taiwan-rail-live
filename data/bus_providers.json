{
  "schemaVersion": 1,
  "_comment": [
    "公車即時到站的取得策略設定檔。新增縣市請只改本檔，不要改 worker.js／bus_live_core.mjs 的邏輯。",
    "provider 只有兩種：",
    "  direct-bulk  —— 該縣市自己公開整份快照，Worker 抓一份所有使用者共用，成本與人數脫鉤、不計 TDX 配額。",
    "  tdx-per-stop —— 沒有直接來源，退回 TDX 逐站查詢。成本隨請求參數線性上升，必須掛 limiter。",
    "🔴 端點網址一律寫在本檔的 endpoints，不可寫死在程式碼裡（設計書單元 C「新增縣市應該是改設定不是改架構」）。",
    "🔴 cities 的鍵就是 TDX 的 City scope 值。2026-09-11 實測 TDX Bus/Station 只收下列 21 個；",
    "   連江縣不在其中，TDX 錯誤訊息原文列出的可接受值不含 Lienchiang／LienchiangCounty／MatsuCounty。",
    "各縣市有無直接來源的清查仍在進行，清查完成後把該縣市改成 direct-bulk 並補 endpoints 即可。"
  ],
  "defaultProvider": "tdx-per-stop",
  "directBulkFormats": {
    "taipei-blobbus-v1": {
      "gzip": true,
      "rootArray": "BusInfo",
      "updateTimePath": "EssentialInfo.UpdateTime",
      "updateTimeFormat": "yyyy/MM/dd HH:mm:ss+08:00",
      "fields": { "route": "RouteID", "stop": "StopID", "estimate": "EstimateTime", "goBack": "GoBack" },
      "estimateUnit": "second",
      "negativeEstimateCodes": {
        "-1": "not_departed",
        "-2": "skipped",
        "-3": "last_bus_passed",
        "-4": "not_operating"
      },
      "goBackCodes": { "0": 0, "1": 1, "2": null, "3": null },
      "docUrl": "https://data.taipei/dataset/detail?id=b2b21fa0-c16b-4ce7-bbf1-de4e3d0b4e0f",
      "docTitle": "臺北市 Data.Taipei 平台 API 說明文件 version 6.3（2025-09-15）",
      "docQuoteEstimateTime": "預估到站剩餘時間（單位：秒） -1：尚未發車 -2：交管不停靠 -3：末班車已過 -4：今日未營運",
      "docQuoteGoBack": "去返程 （0：去程 1：返程 2：尚未發車 3：末班已駛離）"
    }
  },
  "cities": {
    "Taipei": {
      "label": "臺北市",
      "provider": "direct-bulk",
      "tdxScope": "City/Taipei",
      "stopIdPrefix": "TPE",
