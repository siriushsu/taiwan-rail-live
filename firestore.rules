rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasActiveEntitlement(uid) {
      let entitlement = get(/databases/$(database)/documents/entitlements/$(uid));
      // 文件不存在時 get() 回 null,這裡要擋的就是它。寫成 `entitlement.data != null` 不行——
      // 那是先對 null 取 .data,求值錯誤會搶在比較之前發生,該子句永遠不會回 false(實測:整條
      // 刪掉仍 14/14 全綠,換成本寫法後模擬器軌跡由 Null value error 變成乾淨的 false)。
      // 兩種寫法最終都拒絕,但只有這個寫法是這段程式在擋,不是靠平台的求值錯誤語意兜底。
      return entitlement != null
        && entitlement.data.active == true
        && (entitlement.data.activeUntilMs == 0
          || entitlement.data.activeUntilMs > request.time.toMillis());
    }

    // 四份同步文件：pins / favs / rides / stations。只能由本人讀寫，其他使用者完全看不到。
    match /users/{uid}/data/{kind} {
      allow read, delete: if owns(uid) && kind in ['pins', 'favs', 'rides', 'stations'];
      allow create, update: if owns(uid)
        && hasActiveEntitlement(uid)
        && kind in ['pins', 'favs', 'rides', 'stations']
        && request.resource.data.keys().hasOnly([
          'version', 'kind', 'revision', 'clientUpdatedAt', 'items', 'tombstones', 'updatedAt'
        ])
        && request.resource.data.version == 1
        && request.resource.data.kind == kind
        && request.resource.data.revision is int
        && request.resource.data.clientUpdatedAt is int
        && request.resource.data.items is list
        && request.resource.data.tombstones is list
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.tombstones.size() <= 2000
        && (kind != 'pins' || request.resource.data.items.size() <= 800)
        && (kind != 'favs' || request.resource.data.items.size() <= 1000)
        && (kind != 'rides' || request.resource.data.items.size() <= 2000)
        && (kind != 'stations' || request.resource.data.items.size() <= 500);
    }

    // Plus 資格只能由本人讀；寫入必須由受信任的購買驗證後端使用 Admin SDK 完成。
    match /entitlements/{uid} {
      allow read: if owns(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
