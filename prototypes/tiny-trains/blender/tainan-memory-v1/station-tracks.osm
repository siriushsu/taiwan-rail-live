 <node id="12625951258" visible="true" version="2" changeset="175425402" timestamp="2025-12-03T01:16:29Z" user="crgbsly" uid="9093997" lat="23.0016169" lon="120.2148284">
  <tag k="artist_name" v="阿木司設計 Amuse Design"/>
  <tag k="artwork_type" v="sculpture"/>
  <tag k="height" v="390 cm"/>
  <tag k="inscription" v="想像晶片電路之間的微連接，是一個又一個通往未來的路徑，彷若生物神經元在電位消長之間，互相連結形成網絡，與感官鏈結，一次次地壯大生長、擴增感知、開拓覺寫、再次地跨越二元，模糊象界，在有機與無機之間創造路徑，提供詩意的無限可能。"/>
  <tag k="length" v="530 cm"/>
  <tag k="level" v="0"/>
  <tag k="material" v="stainless_steel;led"/>
  <tag k="name" v="光徑"/>
  <tag k="name:en" v="Trajectory of Light"/>
  <tag k="start_date" v="2023"/>
  <tag k="tourism" v="artwork"/>
  <tag k="website" v="https://artcenter.ncku.edu.tw/p/412-1005-30096.php?Lang=zh-tw"/>
  <tag k="width" v="160 cm"/>
 </node>
