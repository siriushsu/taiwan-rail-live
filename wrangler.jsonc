// Cloudflare Workers 部署設定:根目錄當靜態資產(排除清單見 .assetsignore),
// worker.js 只接 /api/*。name 必須對上 dashboard 建立的 Worker 名稱。
// 鐵則:不設 run_worker_first——靜態資產直出免費不限量,只有非資產路徑(/api/*)才喚醒 Worker。
// 2026-07-11 曾因 run_worker_first:true 讓所有資產請求計入免費方案 10 萬次/天,爆 Error 1027 全站被鎖。
// 資產的安全標頭由根目錄 _headers 檔補(Worker 不再經手資產)。
{
  "name": "taiwan-rail-live",
  "compatibility_date": "2026-07-09",
  "main": "worker.js",
  "routes": [
    { "pattern": "railisland.tw", "custom_domain": true },
    { "pattern": "www.railisland.tw", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  // D1 綁定:預先算好的統計 blob(如台鐵準點率)存放處,/api/delay-stats 唯讀單列查詢用
  "d1_databases": [
    { "binding": "DELAY_DB", "database_name": "railisland-delay-history", "database_id": "33a943cc-50af-4ee3-905c-534db842a48b" },
    // 北捷看板事件帳本(B1):每分鐘 cron 寫到站/出發事件,/api/trtc-live 的 ledger 欄位讀它。
    // 2026-08-03 建於 APAC。schema 由 worker 啟動時 CREATE TABLE IF NOT EXISTS 自建,無 migration 工具。
    { "binding": "TRTC_LEDGER", "database_name": "railisland-trtc-ledger", "database_id": "d9f5267d-f670-4657-b261-5bff39c51ebc" }
  ],
  // Analytics Engine 綁定:
  // USAGE  :/api/tra-live 每筆請求埋點(cam/z/裝置),用來回答放空/跟車/靜止各佔多少前景分鐘
  // TRAFFIC:每筆 /api/* 按來源分流(App 殼 vs 網頁),用來回答「Worker 請求數裡 App 佔多少」——
  //         兩邊打的是同一顆 Worker 同一個網域,CF 自己的請求計數把它們混成一個數字。
  //         查法:node scripts/usage_split.mjs
  "analytics_engine_datasets": [
    { "binding": "USAGE", "dataset": "railisland_usage" },
    { "binding": "TRAFFIC", "dataset": "railisland_traffic" }
  ],
  // Cron 觸發(UTC;15 1=台北 09:15、15 4=台北 12:15):scheduled handler 跑台鐵準點統計
  // 每日增量(抓 TDX 歷史前一日→寫 D1→重建 blob)。TDX 每日台北 08:00 更新前一日資料,
  // 第一發 09:15 抓;第二發 12:15 是自癒備援,補上第一發若尚未更新或失敗的缺口(冪等,重跑無害)。
  //
  // 🔴 2026-07-29 暫時停掉第二發(12:15)。原因不在誤點統計,在**懸賞估值 cron 只掛在這一發**
  // (見 worker.js 的 scheduled():`event.cron === '15 4 * * *'`)。它一跑就會把
  // data/bounty_units.json 的 3647 個計價單位整批上架成 281 張卡,其中 **167 張是 dwell(停站點)卡；
  // 停用當時有兩個結構洞**:
  //   ・名字永遠是「線名 → 空白」——bountyCardName() 拿 unitKeys 比對 rec.segs(鍵是 站A|站B),
  //     dwell 的段鍵兩端同名,比不中就走 `return { from: rec.name, to: '' }`(index.html:9944)
  //   ・而且不可能完成——coverageOf() 第一行就 `if (a.name === b.name) continue`(worker.js:1278),
  //     dwell 段永遠進不了 coverage,sample_count 不會加、點數不給、認領不會關
  // 誤點統計這邊的代價只有「今天沒有第二次補抓」,09:15 那發是冪等且已經跑過,不影響資料。
  // 2026-07-29 兩洞已在本機修好並驗收；12:15 cron 仍是 owner 刻意停用。是否恢復只由 owner
  // 決定，agent 不得自行把 "15 4 * * *" 加回來或部署 triggers。
  "triggers": {
    "crons": ["* * * * *", "15 1 * * *"]
  },
  // 速率限制(2026-07-26 稽核):/api/delay-history 與 /api/account-delete 在驗證階段就會對
  // Firebase identitytoolkit 與 RevenueCat 各發一次 outbound fetch——而那發生在「token 有沒有效」
  // 判斷出來之前,所以隨便一串垃圾 Bearer 就能逼我們打上游一次,是不需要任何憑證的放大攻擊。
  // 這裡按來源 IP 節流,擋在外部呼叫前面。period 只接受 10 或 60。
  // namespace_id 在同一個 Worker 內唯一即可,數字本身沒有意義。
  // BOUNTY_LIMITER:懸賞的三個 POST(認領/上傳/合併)共用。30 次/分鐘的來源:上傳是沿途每 60 秒一批,
  // 正常使用者每分鐘 1 發;30 已經寬到不會誤擋多開分頁的人,又擋得住灌樣本。擋在任何 D1 寫入之前。
  // BASEMAP_LIMITER 的理由不同:/api/basemap-token 無從要求憑證(token 本來就得送到瀏覽器才用得了),
  // 節流是要擋「拿它當公用 token 水龍頭迴圈抽取」——抽走的每一把都會去打我們計費的 Esri 額度。
  // 60 次/分鐘對真人綽綽有餘(前端整個 session 只取一次,失敗才重試)。
  "unsafe": {
    "bindings": [
      { "name": "AUTH_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
      { "name": "DELETE_LIMITER", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
      { "name": "BOUNTY_LIMITER", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
      { "name": "BASEMAP_LIMITER", "type": "ratelimit", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
